# Create a fresh key in the DeepSeek platform. Never commit the real value.
DEEPSEEK_API_KEY=replace-me

# Optional overrides
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TIMEOUT=60
# DEEPSEEK_MAX_RETRIES=3
# DEEPSEEK_MAX_HISTORY_MESSAGES=40
# DEEPSEEK_STATE_PATH=~/.local/state/deepseek-agent/conversation.json

# Optional Langfuse OTEL export (set both keys together)
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me
# US: https://us.cloud.langfuse.com | EU: https://cloud.langfuse.com
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
